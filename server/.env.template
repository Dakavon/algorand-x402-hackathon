# Seller account — PUBLIC address only (the server never holds a private key).
AVM_ADDRESS=PASTE_SELLER_ADDRESS_HERE

# Hosted facilitator that verifies + settles payments on-chain (fixed).
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Port the x402 server listens on.
PORT=4021

# Phase 0/1: fixed price per kWh (USD). Dynamic pricing comes in Phase 2.
PRICE_PER_KWH=0.01

# Laptop-only simulation (no Pi): when true, the fallback producer reports the EV
# as plugged in (with solar) so the agent buys on a loop. Leave false once a real
# Pi producer is online — its /status overrides this.
MOCK_EV_PLUGGED=false

# Producer (Pi/FastAPI) base URL used for /status, /history and /consume.
PI_URL=http://localhost:8001

# Agent state service base URL used for /api/snapshot and /api/health.
AGENT_URL=http://localhost:4022
