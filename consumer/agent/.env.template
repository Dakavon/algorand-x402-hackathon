# Buyer account — 25-word mnemonic (SECRET; never commit). The agent signs payments with this.
AVM_MNEMONIC=PASTE_BUYER_25_WORD_MNEMONIC_HERE

# Where the seller's x402 server is running.
RESOURCE_SERVER_URL=http://localhost:4021

# Endpoint to buy energy from.
ENDPOINT_PATH=/energy/buy

# Agent service port (state and events API for dashboard aggregation).
PORT=4022

# Budget and policy caps.
BUDGET_USD=5.00
MAX_PRICE_PER_KWH=0.20
KWH_PER_PURCHASE=1

# Poll cadence and accelerated delivery simulation.
POLL_INTERVAL_MS=2000
ACCEL=60
